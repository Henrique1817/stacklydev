{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackly",
  "version": "0.1.0",
  "identifier": "com.stackly.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stackly",
        "width": 560,
        "height": 760,
        "minWidth": 440,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "COLE_AQUI_A_CHAVE_PUBLICA_GERADA_COM_TAURI_SIGNER",
      "endpoints": [
        "https://github.com/SEU_USUARIO/stackly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}